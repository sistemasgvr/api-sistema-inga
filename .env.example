# Facturación electrónica SUNAT (APIsPERU)
# URL base del servicio de APIsPERU (la entrega APIsPERU).
APISPERU_URL=
# Tiempo máximo de espera por llamada, en milisegundos.
APISPERU_TIMEOUT_MS=60000
# Llave para cifrar token, clave SOL y certificado (mínimo 32 caracteres). No cambiarla luego.
SUNAT_CRYPTO_KEY=
# false desactiva el envío automático al vencer el plazo y la consulta de tickets.
SUNAT_PROGRAMADOR=true
